@page
@model Sneaker_Store.Pages.adminSideLogin.IndexLoginAModel

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-0">Admin</h1>
        <p class="text-muted mb-0">Logget ind som @Model.KundeLoggedIn?.Navn @Model.KundeLoggedIn?.Efternavn</p>
    </div>
    <a asp-page="../Index" class="btn btn-outline-secondary">Tilbage til shop</a>
</div>

<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <h5 class="card-title mb-3">Opret ny sko</h5>
        <p class="text-muted small mb-3">Tip: for at have flere størrelser af samme sko, opret den flere gange med samme mærke/model men forskellig størrelse og lagerantal — de vises samlet i shoppen med en størrelsesvælger.</p>
        <form id="opretForm" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label">Mærke</label>
                <input type="text" class="form-control" id="nyMaerke" required />
            </div>
            <div class="col-md-2">
                <label class="form-label">Model</label>
                <input type="text" class="form-control" id="nyModel" required />
            </div>
            <div class="col-md-1">
                <label class="form-label">Str.</label>
                <input type="number" class="form-control" id="nyStr" required />
            </div>
            <div class="col-md-2">
                <label class="form-label">Pris (DKK)</label>
                <input type="number" step="0.01" class="form-control" id="nyPris" required />
            </div>
            <div class="col-md-1">
                <label class="form-label">Lager</label>
                <input type="number" class="form-control" id="nyLagerAntal" value="0" required />
            </div>
            <div class="col-md-3">
                <label class="form-label">Billede-URL</label>
                <input type="url" class="form-control" id="nyBillede" placeholder="https://..." />
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary w-100">Opret</button>
            </div>
        </form>
    </div>
</div>

<p id="fejlBesked" class="text-danger"></p>

<div class="card shadow-sm">
    <table class="table align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Billede</th>
                <th>Mærke</th>
                <th>Model</th>
                <th>Str.</th>
                <th>Pris (DKK)</th>
                <th>Lager</th>
                <th></th>
            </tr>
        </thead>
        <tbody id="skoTabel"></tbody>
    </table>
</div>

@section Scripts {
    <script>
        async function hentSko() {
            const response = await fetch('/api/sko');
            const sko = await response.json();
            renderTabel(sko);
        }

        function renderTabel(skoListe) {
            const tbody = document.getElementById('skoTabel');
            tbody.innerHTML = skoListe.map(sko => `
                <tr data-id="${sko.skoId}">
                    <td>${sko.skoId}</td>
                    <td>
                        <img src="${sko.billede ?? ''}" alt="" style="width:60px;height:45px;object-fit:cover;border-radius:.25rem;" class="mb-1 d-block" onerror="this.style.display='none'" />
                        <input type="url" class="form-control form-control-sm felt-billede" value="${sko.billede ?? ''}" placeholder="https://..." />
                    </td>
                    <td><input type="text" class="form-control form-control-sm felt-maerke" value="${sko.maerke}" /></td>
                    <td><input type="text" class="form-control form-control-sm felt-model" value="${sko.model}" /></td>
                    <td><input type="number" class="form-control form-control-sm felt-str" value="${sko.str}" style="width:5rem;" /></td>
                    <td><input type="number" step="0.01" class="form-control form-control-sm felt-pris" value="${sko.pris}" style="width:7rem;" /></td>
                    <td><input type="number" class="form-control form-control-sm felt-lager" value="${sko.lagerAntal}" style="width:5rem;" /></td>
                    <td class="text-nowrap">
                        <button class="btn btn-sm btn-outline-primary btn-gem">Gem</button>
                        <button class="btn btn-sm btn-outline-danger btn-slet">Slet</button>
                    </td>
                </tr>
            `).join('');
        }

        async function visFejl(response) {
            const fejlEl = document.getElementById('fejlBesked');
            if (response.status === 401 || response.status === 403) {
                fejlEl.textContent = 'Du har ikke adgang til denne handling (log ind som admin).';
            } else {
                fejlEl.textContent = 'Der opstod en fejl (' + response.status + ').';
            }
        }

        document.getElementById('opretForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            document.getElementById('fejlBesked').textContent = '';

            const nySko = {
                maerke: document.getElementById('nyMaerke').value,
                model: document.getElementById('nyModel').value,
                str: parseInt(document.getElementById('nyStr').value, 10),
                pris: parseFloat(document.getElementById('nyPris').value),
                lagerAntal: parseInt(document.getElementById('nyLagerAntal').value, 10),
                billede: document.getElementById('nyBillede').value || null
            };

            const response = await fetch('/api/sko', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(nySko)
            });

            if (!response.ok) {
                await visFejl(response);
                return;
            }

            e.target.reset();
            hentSko();
        });

        document.getElementById('skoTabel').addEventListener('click', async (e) => {
            const row = e.target.closest('tr');
            if (!row) return;
            const id = row.dataset.id;
            document.getElementById('fejlBesked').textContent = '';

            if (e.target.classList.contains('btn-slet')) {
                const response = await fetch(`/api/sko/${id}`, { method: 'DELETE' });
                if (!response.ok) {
                    await visFejl(response);
                    return;
                }
                hentSko();
            }

            if (e.target.classList.contains('btn-gem')) {
                const opdateretSko = {
                    skoId: parseInt(id, 10),
                    maerke: row.querySelector('.felt-maerke').value,
                    model: row.querySelector('.felt-model').value,
                    str: parseInt(row.querySelector('.felt-str').value, 10),
                    pris: parseFloat(row.querySelector('.felt-pris').value),
                    lagerAntal: parseInt(row.querySelector('.felt-lager').value, 10),
                    billede: row.querySelector('.felt-billede').value || null
                };

                const response = await fetch(`/api/sko/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(opdateretSko)
                });

                if (!response.ok) {
                    await visFejl(response);
                    return;
                }
                hentSko();
            }
        });

        hentSko();
    </script>
}
