@page
@model Sneaker_Store.Pages.KundeSideLogin.IndexLoginK

<h1>Min side</h1>
<p>Logget ind som @Model.KundeLoggedIn?.Navn @Model.KundeLoggedIn?.Efternavn (@Model.KundeLoggedIn?.Email)</p>

<h3>Mine ordrer</h3>
<table class="table">
    <thead>
        <tr>
            <th>Ordre-id</th>
            <th>Sko</th>
            <th>Antal</th>
            <th>Total pris (DKK)</th>
        </tr>
    </thead>
    <tbody id="ordreTabel">
        <tr><td colspan="4">Henter ordrer...</td></tr>
    </tbody>
</table>

<a asp-page="../Index">Tilbage til shop</a>

@section Scripts {
    <script>
        async function hentOrdrer() {
            const tbody = document.getElementById('ordreTabel');
            const [ordreResponse, skoResponse] = await Promise.all([
                fetch('/api/ordre/mine'),
                fetch('/api/sko')
            ]);

            if (!ordreResponse.ok || !skoResponse.ok) {
                tbody.innerHTML = '<tr><td colspan="4" class="text-danger">Kunne ikke hente ordrer.</td></tr>';
                return;
            }

            const ordrer = await ordreResponse.json();
            const sko = await skoResponse.json();

            if (ordrer.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4">Du har ingen ordrer endnu.</td></tr>';
                return;
            }

            tbody.innerHTML = ordrer.map(ordre => {
                const tilhoerendeSko = sko.find(s => s.skoId === ordre.skoId);
                const skoNavn = tilhoerendeSko ? `${tilhoerendeSko.maerke} ${tilhoerendeSko.model}` : `Sko #${ordre.skoId}`;
                return `
                    <tr>
                        <td>${ordre.ordreId}</td>
                        <td>${skoNavn}</td>
                        <td>${ordre.antal}</td>
                        <td>${ordre.totalPris}</td>
                    </tr>
                `;
            }).join('');
        }

        hentOrdrer();
    </script>
}
