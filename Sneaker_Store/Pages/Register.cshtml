@page
@model Sneaker_Store.Pages.RegisterModel
@{
    ViewData["Title"] = "Opret bruger";
}

<div class="auth-card">
    <h1 class="h3 mb-3 text-center">Opret bruger</h1>

    @if (Model.FejlBesked is not null)
    {
        <div class="alert alert-danger py-2">@Model.FejlBesked</div>
    }

    <form method="post">
        <div class="row">
            <div class="col-6 mb-2">
                <label class="form-label">Navn</label>
                <input type="text" class="form-control" asp-for="@Model.Navn" required />
            </div>
            <div class="col-6 mb-2">
                <label class="form-label">Efternavn</label>
                <input type="text" class="form-control" asp-for="@Model.Efternavn" />
            </div>
        </div>
        <div class="mb-2">
            <label class="form-label">Email</label>
            <input type="email" class="form-control" asp-for="@Model.Email" required />
        </div>
        <div class="mb-2">
            <label class="form-label">Adresse</label>
            <input type="text" class="form-control" asp-for="@Model.Adresse" />
        </div>
        <div class="row">
            <div class="col-8 mb-2">
                <label class="form-label">By</label>
                <input type="text" class="form-control" asp-for="@Model.By" />
            </div>
            <div class="col-4 mb-2">
                <label class="form-label">Postnr</label>
                <input type="number" class="form-control" asp-for="@Model.Postnr" />
            </div>
        </div>
        <div class="mb-1">
            <label class="form-label">Kode</label>
            <input type="password" class="form-control" asp-for="@Model.Kode" required
                   pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^a-zA-Z0-9]).{7,}$"
                   title="@Model.PasswordKrav" />
        </div>
        <p class="form-text text-muted mb-3">@Model.PasswordKrav</p>
        <button type="submit" class="btn btn-primary w-100">Opret</button>
    </form>

    <p class="text-center mt-3 mb-0"><a asp-page="/Login">Har du allerede en bruger? Log ind</a></p>
</div>
